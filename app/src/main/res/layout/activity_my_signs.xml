<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:background="#F4F7FB">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🤟 Mis señas" android:textSize="28sp" android:textStyle="bold" android:textColor="#0F172A"/>
    <TextView android:id="@+id/txtMySignsEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Mis señas" android:textColor="#64748B"/>
    <Button android:id="@+id/btnTrainNewSign" android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="14dp" android:text="＋ Entrenar nueva seña" android:textAllCaps="false"
        android:background="@drawable/bg_primary_button" android:textColor="#FFFFFF"/>
    <ListView android:id="@+id/listMySigns" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="12dp" android:background="@drawable/bg_card"/>
</LinearLayout>
