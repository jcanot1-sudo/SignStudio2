<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="22dp"
    android:gravity="center_vertical"
    android:background="#F4F7FB">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="▶ Demostración guiada"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#0F172A"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Recorrido recomendado para presentar la versión final"
        android:textColor="#64748B"
        android:textSize="14sp"/>
    <TextView
        android:id="@+id/txtDemoStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#2563EB"/>
    <TextView
        android:id="@+id/txtDemoInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="20dp"
        android:background="@drawable/bg_card"
        android:textSize="18sp"
        android:lineSpacingExtra="5dp"
        android:textColor="#0F172A"/>
    <Button
        android:id="@+id/btnDemoAction"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_primary_button"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:textStyle="bold"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">
        <Button
            android:id="@+id/btnDemoAnterior"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_secondary_button"
            android:text="← Anterior"
            android:textAllCaps="false"/>
        <Button
            android:id="@+id/btnDemoSiguiente"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_secondary_button"
            android:text="Siguiente →"
            android:textAllCaps="false"/>
    </LinearLayout>
    <Button
        android:id="@+id/btnVolverDemo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_secondary_button"
        android:text="← Volver al inicio"
        android:textAllCaps="false"/>
</LinearLayout>
