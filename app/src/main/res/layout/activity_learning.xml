<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎓 Modo Aprendizaje"
            android:textColor="#0F172A"
            android:textSize="29sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Observa únicamente la seña y selecciona la respuesta correcta."
            android:textColor="#64748B"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtPuntuacionAprendizaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_status_chip"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="Puntuación: 0 / 0"
            android:textColor="#0C4A6E"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtPreguntaAprendizaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Observa la seña y elige la respuesta correcta"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card">

            <ImageView
                android:id="@+id/imgSenaAprendizaje"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="Seña visual de aprendizaje"/>

            <ProgressBar
                android:id="@+id/progressAprendizaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"/>
        </FrameLayout>

        <TextView
            android:id="@+id/txtResultadoAprendizaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnOpcion1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_secondary_button"
                android:text="A"
                android:textAllCaps="false"
                android:textSize="18sp"/>
            <Button
                android:id="@+id/btnOpcion2"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_secondary_button"
                android:text="B"
                android:textAllCaps="false"
                android:textSize="18sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnOpcion3"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_secondary_button"
                android:text="C"
                android:textAllCaps="false"
                android:textSize="18sp"/>
            <Button
                android:id="@+id/btnOpcion4"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_secondary_button"
                android:text="D"
                android:textAllCaps="false"
                android:textSize="18sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSiguienteAprendizaje"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_primary_button"
            android:enabled="false"
            android:text="Siguiente pregunta →"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnCambiarModoAprendizaje"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_secondary_button"
            android:text="Cambiar a números 0–9"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnVolverAprendizaje"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_secondary_button"
            android:text="← Volver al inicio"
            android:textAllCaps="false"/>
    </LinearLayout>
</ScrollView>
