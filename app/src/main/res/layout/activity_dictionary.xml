<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 Diccionario SignTranslate"
            android:textColor="#0F172A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Busca palabras y frases de uso cotidiano por categoría."
            android:textColor="#64748B"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inputBuscarDiccionario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_input"
            android:hint="🔎 Buscar palabra o frase"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:singleLine="true" />

        <Spinner
            android:id="@+id/spinnerCategoriaDiccionario"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />

        <TextView
            android:id="@+id/txtConteoDiccionario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#334155"
            android:textStyle="bold"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/listaDiccionario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnVolverDiccionario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_secondary_button"
            android:text="← Volver"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
