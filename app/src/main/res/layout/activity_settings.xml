<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F7FB">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚙ Ajustes de reconocimiento" android:textSize="26sp" android:textStyle="bold" android:textColor="#0F172A"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Personaliza SignTranslate para cada usuario y situación." android:textColor="#64748B" android:textSize="15sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Perfil activo" android:textStyle="bold" android:textColor="#0F172A"/>
<Spinner android:id="@+id/spinnerProfile" android:layout_width="match_parent" android:layout_height="54dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Velocidad / estabilidad" android:textStyle="bold" android:textColor="#0F172A"/>
<Spinner android:id="@+id/spinnerSpeed" android:layout_width="match_parent" android:layout_height="54dp"/>
<TextView android:id="@+id/txtConfidenceValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Confianza mínima: 90%" android:textStyle="bold" android:textColor="#0F172A"/>
<SeekBar android:id="@+id/seekConfidence" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:min="70"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="14dp" android:background="@drawable/bg_card" android:text="🔒 Privacidad\nLa cámara se procesa en el dispositivo. Las señas entrenadas y el historial se guardan localmente. El reconocimiento de voz puede depender del servicio de voz instalado en Android." android:textColor="#334155" android:textSize="14sp"/>
<Button android:id="@+id/btnGuardarAjustes" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="22dp" android:background="@drawable/bg_primary_button" android:text="Guardar ajustes" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"/>
<Button android:id="@+id/btnVolverAjustes" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/bg_secondary_button" android:text="← Volver" android:textAllCaps="false" android:textColor="#0F172A"/>
</LinearLayout></ScrollView>
