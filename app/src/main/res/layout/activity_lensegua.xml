<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FB">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🤟 Módulo LENSEGUA"
            android:textSize="29sp"
            android:textStyle="bold"
            android:textColor="#0F172A"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Frases rápidas y secuencia visual de apoyo"
            android:textColor="#64748B"
            android:textSize="14sp"/>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Traducir palabra a deletreo LENSEGUA"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="19sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Escribe una palabra y SignTranslate reproducirá sus letras automáticamente."
                android:textColor="#64748B"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/inputPalabraLensegua"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="Ejemplo: CASA"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"/>

            <Button
                android:id="@+id/btnTraducirPalabra"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_primary_button"
                android:text="▶ Traducir y reproducir"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textStyle="bold"/>
        </LinearLayout>

<TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Abecedario LENSEGUA"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="20sp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <LinearLayout
                android:id="@+id/panelAbecedario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Números"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="20sp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <LinearLayout
                android:id="@+id/panelNumeros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            </LinearLayout>
        </HorizontalScrollView>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btnHola" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_secondary_button" android:text="Hola" android:textAllCaps="false"/>
            <Button android:id="@+id/btnGracias" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:background="@drawable/bg_secondary_button" android:text="Gracias" android:textAllCaps="false"/>
            <Button android:id="@+id/btnAyuda" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/bg_secondary_button" android:text="Ayuda" android:textAllCaps="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btnPorFavor" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1.4" android:layout_marginEnd="4dp" android:background="@drawable/bg_secondary_button" android:text="Por favor" android:textAllCaps="false"/>
            <Button android:id="@+id/btnSi" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="0.8" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:background="@drawable/bg_secondary_button" android:text="Sí" android:textAllCaps="false"/>
            <Button android:id="@+id/btnNo" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="0.8" android:layout_marginStart="4dp" android:background="@drawable/bg_secondary_button" android:text="No" android:textAllCaps="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card">

            <TextView android:id="@+id/txtLenseguaFrase" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Selecciona una frase" android:textColor="#0F172A" android:textSize="19sp" android:textStyle="bold"/>
            <TextView android:id="@+id/txtLenseguaSecuencia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Secuencia: ---" android:textColor="#475569" android:textSize="15sp"/>
            <TextView android:id="@+id/txtLetraActual" android:layout_width="match_parent" android:layout_height="100dp" android:layout_marginTop="14dp" android:gravity="center" android:text="—" android:textColor="#2563EB" android:textSize="64sp" android:textStyle="bold"/>
            <TextView android:id="@+id/txtProgreso" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="0 / 0" android:textColor="#64748B" android:textSize="14sp"/>
            <com.tu.org.signstudio.DynamicSignPlayerView android:id="@+id/dynamicSignPlayer" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="10dp" android:background="#F8FAFC" android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <Button android:id="@+id/btnAnterior" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_secondary_button" android:text="← Anterior" android:textAllCaps="false"/>
            <Button android:id="@+id/btnSiguiente" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/bg_secondary_button" android:text="Siguiente →" android:textAllCaps="false"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/btnReproducir" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_primary_button" android:text="▶ Reproducir" android:textColor="#FFFFFF" android:textAllCaps="false"/>
            <Button android:id="@+id/btnReiniciar" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/bg_secondary_button" android:text="↻ Reiniciar" android:textAllCaps="false"/>
        </LinearLayout>

        <TextView android:id="@+id/txtReferenciaActual" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Referencia visual oficial" android:textColor="#0F172A" android:textSize="18sp" android:textStyle="bold"/>
        <Button android:id="@+id/btnReferenciaOficial" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_secondary_button" android:text="Ver abecedario completo MINEDUC" android:textAllCaps="false"/>
        <ProgressBar android:id="@+id/progressReferenciaOficial" style="?android:attr/progressBarStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:visibility="gone"/>
        <ImageView android:id="@+id/imgReferenciaOficial" android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginTop="10dp" android:adjustViewBounds="true" android:scaleType="fitCenter" android:contentDescription="Referencia oficial LENSEGUA" android:visibility="gone"/>

        <Button android:id="@+id/btnVolver" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="18dp" android:layout_marginBottom="14dp" android:background="@drawable/bg_secondary_button" android:text="← Volver al inicio" android:textAllCaps="false"/>
    </LinearLayout>
</ScrollView>
